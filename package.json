{
    "name": "salesforce-pubsub-api-client",
    "version": "5.6.2",
    "type": "module",
    "description": "A node client for the Salesforce Pub/Sub API",
    "author": "pozil",
    "license": "CC0-1.0",
    "homepage": "https://github.com/pozil/pub-sub-api-node-client",
    "main": "dist/client.js",
    "exports": {
        ".": {
            "types": "./dist/client.d.ts",
            "require": "./dist/client.cjs",
            "import": "./dist/client.js"
        }
    },
    "scripts": {
        "build": "tsup && tsc",
        "test": "jasmine",
        "format": "prettier --write '**/*.{css,html,js,json,md,yaml,yml}'",
        "format:verify": "prettier --check '**/*.{css,html,js,json,md,yaml,yml}'",
        "lint": "eslint .",
        "prepare": "husky || true",
        "precommit": "lint-staged",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.6",
        "@grpc/proto-loader": "^0.8.1",
        "avro-js": "^1.12.2",
        "jsforce": "^3.12.0",
        "underscore": "^1.13.8",
        "undici": "^8.12.2"
    },
    "devDependencies": {
        "@chialab/esbuild-plugin-meta-url": "^0.19.2",
        "@eslint/js": "^10.0.1",
        "dotenv": "^18.0.8",
        "eslint": "^10.13.0",
        "eslint-plugin-jasmine": "^4.2.2",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jasmine": "^7.0.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "tsup": "^9.0.0",
        "typescript": "^7.0.2"
    },
    "lint-staged": {
        "**/*.{css,html,js,json,md,yaml,yml}": [
            "prettier --write"
        ],
        "**/{src,spec}/**/*.js": [
            "eslint"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pozil/pub-sub-api-node-client.git"
    },
    "keywords": [
        "salesforce",
        "pubsub",
        "api",
        "grpc"
    ],
    "files": [
        "dist/*",
        "pubsub_api.proto"
    ],
    "volta": {
        "node": "22.22.2"
    }
}
